module microhttpd2;

alias Request = void;
alias Response = void;
alias Daemon = void;
alias Action = void;

constdef HttpMethod
{
  OTHER = 255,

  /* Main HTTP methods. */
  GET = 1,
  HEAD = 2,
  POST = 3,
  PUT = 4,
  DELETE = 5,
  OPTIONS = 7,
}

enum PostEncoding
{
  OTHER,
  FORM_URLENCODED,
  MULTIPART_FORM_DATA,
  TEXT_PLAIN,
}

enum AddressFamily
{
  AF_NONE,
  AF_AUTO,
}

constdef HttpStatusCode
{
  OK = 200,
  NOT_FOUND = 404,
}

constdef StatusCode
{
  OK = 0,
}

constdef DaemonOption
{
  WORK_MODE = 40,
  BIND_PORT = 80,
}

constdef WorkMode
{
  WORKER_THREADS = 24,
  THREAD_PER_CONNECTION = 32
}

constdef PostParseResult
{
  OK = 0,
  REQUEST_EMPTY = 1,
  OK_BAD_TERMINATION = 2,
  PARTIAL_INVALID_POST_FORMAT = 3,
  FAILED_NO_POOL_MEM = 60,
  FAILED_NO_LARGE_BUF_MEM = 61,
  FAILED_UNKNOWN_CNTN_TYPE = 80,
  FAILED_NO_CNTN_TYPE = 81,
  FAILED_HEADER_NO_BOUNDARY = 82,
  FAILED_HEADER_MISFORMED = 83,
  FAILED_HEADER_NOT_MPART = 84,
  FAILED_INVALID_POST_FORMAT = 90,
}

constdef UploadActionType
{
  NO_ACTION = 0,
  CONTINUE,
  RESPONSE,
  SUSPEND,
  // Only if MHD compiled with HTTP Upgrade support
  UPGRADE,
  ABORT,
}

union UploadActionData
{
  Response *response;
  ulong[2] _abi;
}

struct UploadAction
{
  UploadActionType act;
  UploadActionData data;
}

struct String
{
  usz len;
  ZString cstr;
}

struct StringNullable
{
  usz len;
  ZString cstr;
}

macro String StringNullable.str_view(&self)
{
  if (self.len == 0 || self.cstr == null) return "";

  return self.cstr.str_view();
}

struct WorkModeWithParam
{
  WorkMode mode;
  WorkModeParam params;
}

struct DaemonOptionValueBind
{
  AddressFamily af;
  CUShort port;
}

// sizeof = 16
union WorkModeParam
{
  ulong[2] _abi;
  uint num_worker_threads;
}

// sizeof = 24
union DaemonOptionValue
{
  ulong[3] _abi;
  WorkModeWithParam work_mode;
  DaemonOptionValueBind bind_port;
}

struct DaemonOptionAndValue
{
  DaemonOption opt;
  DaemonOptionValue val;
}

alias UpgradedHandle = void;

constdef ValueKind : CUInt
{
  HEADER = 1 << 0,
  COOKIE = 1 << 1,
  URI_QUERY_PARAM = 1 << 2,
  POSTDATA = 1 << 3,
  TRAILER = 1 << 4,
  HEADER_TRAILER = ValueKind.HEADER | ValueKind.TRAILER,
  URI_QUERY_POST = ValueKind.POSTDATA | ValueKind.URI_QUERY_PARAM,
}

struct NameAndValue
{
  microhttpd2::String name;
  microhttpd2::StringNullable value;
}

alias PanicCallback = fn void (void *cls, ZString file, ZString func, CUInt line, ZString message);
fn void lib_set_panic_func(PanicCallback cb, void *cb_cls) @cname("MHD_lib_set_panic_func");
alias NameValueIterator = fn bool (void *cls, ValueKind kind, NameAndValue *nv);
fn usz request_get_values_cb(Request *request, ValueKind kind, NameValueIterator iterator, void *iterator_cls)
  @cname("MHD_request_get_values_cb");
fn bool request_get_value(Request *request, ValueKind kind, ZString key, StringNullable *value_out)
  @cname("MHD_request_get_value");
alias HandlerFn = fn Action* (void *cls, Request *mreq, microhttpd2::String *path, HttpMethod method, ulong upload_size);
alias FreeCallback = fn void (void *cls);
alias PostDataReader = fn UploadAction* (Request *req, void *cls,
                                         microhttpd2::String *name,
                                         StringNullable *filename,
                                         StringNullable *content_type,
                                         StringNullable *encoding,
                                         usz size, void *data, ulong off,
                                         CInt final_data);
alias PostDataFinished = fn UploadAction* (Request *mreq, void *cls, PostParseResult parsing_result);
alias UpgradeHandler = fn void (void *cls, Request *req, UploadActionData *urh);
fn Daemon* daemon_create(HandlerFn handler_fn, void *cls) @cname("MHD_daemon_create");
fn StatusCode daemon_start(Daemon *d) @cname("MHD_daemon_start");
fn void daemon_destroy(Daemon *d) @cname("MHD_daemon_destroy");
fn StatusCode daemon_set_options(Daemon* d, DaemonOptionAndValue* options, usz options_max_num)
  @cname("MHD_daemon_set_options");
fn Action* action_from_response(Request *mreq, Response *mres) @cname("MHD_action_from_response");
fn Response* response_from_buffer(HttpStatusCode sc, usz buf_size, char *buf, FreeCallback free_cb, void *free_cb_cls)
  @cname("MHD_response_from_buffer");
fn Response* response_from_buffer_copy(HttpStatusCode sc, usz buf_size, char *buf)
  @cname("MHD_response_from_buffer_copy");
fn Response* response_from_empty() @cname("MHD_response_from_empty");
fn microhttpd2::String* http_method_to_string(HttpMethod sc) @cname("MHD_http_method_to_string");
fn StatusCode response_add_header(Response *mres, ZString name, ZString value) @cname("MHD_response_add_header");
fn Response* response_from_fd(HttpStatusCode sc, int fd, ulong offset, ulong size) @cname("MHD_response_from_fd");
fn Action* action_parse_post(Request *mreq, usz buffer_size, usz max_non_stream_size,
                                        PostEncoding enc, PostDataReader stream_reader,
                                        void* reader_cls, PostDataFinished done_cb,
                                        void* done_cb_cls) @cname("MHD_action_parse_post");
fn UploadAction* upload_action_continue(Request *mreq) @cname("MHD_upload_action_continue");
fn UploadAction* upload_action_from_response(
    Request* mreq,
    Response* response
) @cname("MHD_upload_action_from_response");

struct PostField
{
  microhttpd2::String name;
  StringNullable value;
  StringNullable filename;
  StringNullable content_type;
  StringNullable transfer_encoding;
}

alias PostDataIterator = fn bool (void *cls, PostField *data);

fn usz request_get_post_data_cb(Request *mreq, PostDataIterator iterator, void *iterator_cls) @cname("MHD_request_get_post_data_cb");

macro Response *response_from_buffer_static(HttpStatusCode sc, usz buf_len, char *buf)
{
  return response_from_buffer(sc, buf_len, buf, null, null);
}

macro Action* action_abort_request(Request *mreq)
{
  return null;
}
