module mhd2;

alias Request = void;
alias Response = void;
alias Daemon = void;
alias Action = void;

constdef HttpMethod
{
  OTHER = 255,

  /* Main HTTP methods. */
  GET = 1,
  HEAD = 2,
  POST = 3,
  PUT = 4,
  DELETE = 5,
  OPTIONS = 7,
}

enum PostEncoding : int
{
  OTHER,
  FORM_URLENCODED,
  MULTIPART_FORM_DATA,
  TEXT_PLAIN,
}

enum AddressFamily : int
{
  AF_NONE,
  AF_AUTO,
}

constdef HttpStatusCode
{
  OK = 200,
  NOT_FOUND = 404,
}

constdef StatusCode
{
  OK = 0,
}

constdef DaemonOption
{
  WORK_MODE = 40,
  BIND_PORT = 80,
}

constdef WorkMode
{
  WORKER_THREADS = 24,
  THREAD_PER_CONNECTION = 32
}

constdef PostParseResult
{
  OK = 0,
  REQUEST_EMPTY = 1,
  OK_BAD_TERMINATION = 2,
  PARTIAL_INVALID_POST_FORMAT = 3,
  FAILED_NO_POOL_MEM = 60,
  FAILED_NO_LARGE_BUF_MEM = 61,
  FAILED_UNKNOWN_CNTN_TYPE = 80,
  FAILED_NO_CNTN_TYPE = 81,
  FAILED_HEADER_NO_BOUNDARY = 82,
  FAILED_HEADER_MISFORMED = 83,
  FAILED_HEADER_NOT_MPART = 84,
  FAILED_INVALID_POST_FORMAT = 90,
}

constdef UploadActionType
{
  NO_ACTION = 0,
  CONTINUE,
  RESPONSE,
  SUSPEND,
  // Only if MHD compiled with HTTP Upgrade support
  UPGRADE,
  ABORT,
}

union UploadActionData
{
  mhd2::Response *response;
  ulong[2] _abi;
}

struct UploadAction
{
  UploadActionType act;
  UploadActionData data;
}

struct String
{
  usz len;
  ZString cstr;
}

struct StringNullable
{
  usz len;
  ZString cstr;
}

macro String StringNullable.str_view(&self)
{
  if (self.len == 0 || self.cstr == null) return "";

  return self.cstr.str_view();
}

struct WorkModeWithParam
{
  WorkMode mode;
  WorkModeParam params;
}

struct DaemonOptionValueBind
{
  AddressFamily af;
  CUShort port;
}

// sizeof = 16
union WorkModeParam
{
  ulong[2] _abi;
  uint numWorkerThreads;
}

// sizeof = 24
union DaemonOptionValue
{
  ulong[3] _abi;
  WorkModeWithParam workMode;
  DaemonOptionValueBind bindPort;
}

struct DaemonOptionAndValue
{
  DaemonOption opt;
  DaemonOptionValue val;
}

alias UpgradedHandle = void;

constdef ValueKind : CUInt
{
  HEADER = 1 << 0,
  COOKIE = 1 << 1,
  URI_QUERY_PARAM = 1 << 2,
  POSTDATA = 1 << 3,
  TRAILER = 1 << 4,
  HEADER_TRAILER = ValueKind.HEADER | ValueKind.TRAILER,
  URI_QUERY_POST = ValueKind.POSTDATA | ValueKind.URI_QUERY_PARAM,
}

struct NameAndValue
{
  mhd2::String name;
  mhd2::StringNullable value;
}

alias NameValueIterator = fn bool (void *cls, ValueKind kind, mhd2::NameAndValue *nv);

fn usz requestGetValuesCb(Request *request, ValueKind kind, NameValueIterator iterator, void *iteratorCls)
  @cname("MHD_request_get_values_cb");

fn bool requestGetValue(Request *request, ValueKind kind, ZString key, StringNullable *valueOut)
  @cname("MHD_request_get_value");

alias HandlerFn = fn Action* (void *cls, Request *mreq, mhd2::String *path, HttpMethod method, ulong uploadSize);

alias FreeCallback = fn void (void *cls);

alias PostDataReader = fn UploadAction* (Request *req,
                                         void *cls,
                                         mhd2::String *name,
                                         mhd2::StringNullable *filename,
                                         mhd2::StringNullable *contentType,
                                         mhd2::StringNullable *encoding,
                                         usz size,
                                         void *data,
                                         ulong off,
                                         CInt finalData);

alias PostDataFinished = fn UploadAction* (Request *mreq, void *cls, PostParseResult parsingResult);

alias UpgradeHandler = fn void (void *cls, Request *req, UploadActionData *urh);

fn Daemon* daemonCreate(HandlerFn handlerFn, void *cls) @cname("MHD_daemon_create");

fn StatusCode daemonStart(Daemon *d) @cname("MHD_daemon_start");

fn void daemonDestroy(Daemon *d) @cname("MHD_daemon_destroy");

fn StatusCode daemonSetOptions(Daemon* d, DaemonOptionAndValue* options, usz optionsMaxNum)
  @cname("MHD_daemon_set_options");

fn Action *actionFromResponse(Request *mreq, Response *mres) @cname("MHD_action_from_response");

fn Response *responseFromBuffer(HttpStatusCode sc, usz bufSize, char *buf, FreeCallback freeCb, void *freeCbCls)
  @cname("MHD_response_from_buffer");

fn Response *responseFromBufferCopy(HttpStatusCode sc, usz bufSize, char *buf)
  @cname("MHD_response_from_buffer_copy");

fn Response* responseFromEmpty() @cname("MHD_response_from_empty");

fn mhd2::String *httpMethodToString(HttpMethod sc) @cname("MHD_http_method_to_string");

fn StatusCode responseAddHeader(Response *mres, ZString name, ZString value) @cname("MHD_response_add_header");

fn Response *responseFromFd(HttpStatusCode sc, int fd, ulong offset, ulong size) @cname("MHD_response_from_fd");

fn Action* actionParsePost(Request *mreq, usz bufferSize, usz maxNonStreamSize,
                                        PostEncoding enc, PostDataReader streamReader,
                                        void* readerCls, PostDataFinished doneCb,
                                        void* doneCbCls) @cname("MHD_action_parse_post");

fn UploadAction* uploadActionContinue(Request *mreq) @cname("MHD_upload_action_continue");

fn UploadAction* uploadActionFromResponse(
    Request* mreq,
    Response* response
) @cname("MHD_upload_action_from_response");

struct PostField
{
  mhd2::String name;
  mhd2::StringNullable value;
  mhd2::StringNullable filename;
  mhd2::StringNullable contentType;
  mhd2::StringNullable transferEncoding;
}

alias PostDataIterator = fn bool (void *cls, PostField *data);

fn usz requestGetPostDataCb(Request *mreq, PostDataIterator iterator, void *iteratorCls) @cname("MHD_request_get_post_data_cb");

macro Response *responseFromBufferStatic(HttpStatusCode sc, usz bufLen, char *buf)
{
  return responseFromBuffer(sc, bufLen, buf, null, null);
}

macro Action* actionAbortRequest(Request *mreq)
{
  return null;
}

macro @to_mhd_string(String $str)
{
  return (StringNullable) { $str.len, $str };
}

macro @to_mhd_string_nullable(String $str)
{
  return (StringNullable) { $str.len, $str };
}

alias PanicCallback = fn void (void *cls, ZString file, ZString func, CUInt line, ZString message);

fn void libSetPanicFunc(PanicCallback cb, void *cbCls) @cname("MHD_lib_set_panic_func");
