{
  "langrev": "1",
  "warnings": [ "no-unused" ],
  "authors": [ "Dmytro Zhukov <weary.gerbill@gmail.com>" ],
  "version": "0.1.0",
  "sources": [ "src/**" ],
  "output": "build",
  "dependency-search-paths": ["lib"],
  "dependencies": ["lua", "sqlite3", "microhttpd2"],
  "script-dir": ".",
  "targets": {
    // dev: plain dep builds, templates/assets loaded from disk at runtime
    "tierlister": {
      "type": "executable",
      "linker-search-paths": ["third_party/libmicrohttpd2/build-dev/src/mhd2/.libs", "third_party/lua", "third_party/sqlite"]
    },
    // release: static binary, templates/assets embedded, deps built tight and small
    //   - MHD:    compact code, no error messages or log strings
    //   - SQLite: 17 unused features omitted via configure + CFLAGS
    "tierlister-release": {
      "type": "executable",
      "features": ["EMBED_TEMPLATES", "EMBED_ASSETS"],
      "linker-search-paths": ["third_party/libmicrohttpd2/build-release/src/mhd2/.libs", "third_party/lua", "third_party/sqlite/build-release"]
    }
  },
  "cpu": "generic"
}
